# Copy to spark/cluster.env (git ignores it) and fill in; the launch scripts read it. Values already set in the
# environment win for the ${VAR:-...} lines.
#
# Nodes: "ssh-target:home:lan-ip", rank 0 first ("local" = the machine you run the scripts on). Rank 0 serves the API
# and the vision tower. lan-ip is the address the other ranks reach rank 0 at for the bootstrap (torchrun store).
NODES3="user@spark-a:/home/user:192.168.1.21 local:/home/user:192.168.1.22 user@spark-c:/home/user:192.168.1.23"
NODES2="user@spark-a:/home/user:192.168.1.21 local:/home/user:192.168.1.22"

# Model folders under <home>/models/ on every node
MODEL3=Inkling-2-Small-EXL3-3.48bpw
MODEL2=Inkling-2-Small-EXL3-2.55bpw-2Spark

# Container image: the one the exllamav3 extension was built in (README: "Build")
IMAGE=${IMAGE:-nvcr.io/nvidia/pytorch:26.07-py3}

# LAN interface for the NCCL/gloo bootstrap (TCP); see `ip -br addr`. The tensor-parallel traffic itself is RoCE.
BOOTSTRAP_IF=${BOOTSTRAP_IF:-enP7s7}

# Optional: a directory holding a different libnccl.so.2 (mounted at /opt/nccl-patched and preloaded). Three Sparks
# cabled as a triangle need a NCCL that routes each peer over its own link (README: "Three nodes"); two do not.
# A leading ~/ means each node's own home; quote it so it is not expanded here, e.g. "~/nccl-patched". Not /tmp:
# DGX OS empties /tmp at every boot.
NCCL_DIR=${NCCL_DIR:-}
