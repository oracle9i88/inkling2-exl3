+#include "exl3_moe_coop_instances.cuh"
+#include "../exl3_moe_coop_kernel.cuh"
+
+// Mixed rates, mul1 codebook: every block decodes its expert at the width of its rate code (1.5 ... 4 bpw, see
+// gemv_tile_mk). The shared-memory layout is the staged one (1.5 / 2.5 / 3 / 3.5 bpw stage; 2 and 4 leave it unused),
+// so the template width only sizes it and is otherwise unused
+
+MoeCoopKernel exl3_moe_coop_kernel_a_mk(int Hi, bool wide)
+{
+    using namespace exl3_moe_coop_ns;
+    const int smem = smem_a_bytes<1, true>(Hi);
+    if (wide) return { (void*) exl3_moe_coop_a_kernel<4, 2, true, false, true>, smem };
+    return { (void*) exl3_moe_coop_a_kernel<4, 2, false, false, true>, smem };
+}
+
+MoeCoopKernel exl3_moe_coop_kernel_b_mk(bool wide)
+{
+    using namespace exl3_moe_coop_ns;
+    const int smem = smem_b_bytes<1, true>();
+    if (wide) return { (void*) exl3_moe_coop_b_kernel<4, 2, true, false, true>, smem };
+    return { (void*) exl3_moe_coop_b_kernel<4, 2, false, false, true>, smem };
+}
